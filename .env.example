# Copy to .env on the server and fill in. Never commit .env.
PUBLIC_URL=https://rift.shyy.dev
# Discord Developer Portal -> your app -> OAuth2. Redirect URL there:
#   https://rift.shyy.dev/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Any long random string (e.g. openssl rand -hex 24)
POSTGRES_PASSWORD=
# Cloudflare Zero Trust -> Networks -> Tunnels -> create, copy the token.
# Public hostname there: rift.shyy.dev -> http://app:8080
TUNNEL_TOKEN=
# Port on the server's localhost, for checks (curl 127.0.0.1:8080/api/health)
APP_PORT=8080

# Only without the Cloudflare tunnel, behind a reverse proxy of your own (DEPLOY.md, variant B):
# TRUST_PROXY=forwarded
# APP_BIND=127.0.0.1   (the address the proxy reaches the app on; 0.0.0.0 only if a firewall closes the port)

# Legal notice and privacy notice: who runs the site. Name and town only, no street
# (Austria, § 25 (5) MedienG); the e-mail is the contact for privacy requests.
OPERATOR_NAME=Paul Sprung
OPERATOR_PLACE=Salzburg, Austria
OPERATOR_EMAIL=rift@shyy.dev
# Who hosts the server, for the privacy notice, e.g. "Hetzner Online GmbH (Germany)"; empty: your own machine
OPERATOR_HOSTING=Hetzner Online GmbH (Germany)
